@* Khai báo kiểu dữ liệu Model nhận từ Controller *@
@model List<string>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h2>@ViewData["Title"]</h2>

@* Kiểm tra nếu danh sách có dữ liệu thì mới hiển thị *@
@if (Model != null && Model.Any())
{
    <ul>
        @foreach (var ten in Model)
        {
            <li>@ten</li>
        }
    </ul>
}
else
{
    <p>Không có dữ liệu trong danh sách.</p>
}